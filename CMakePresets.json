{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 2
  },

  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
      }
    },

    {
      "name": "clang-debug-base",
      "hidden": true,
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CLANG_TIDY": "ON",
        "ENABLE_CLANG_FORMAT_CHECK": "ON"
      }
    },

    {
      "name": "clang-release-base",
      "hidden": true,
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_CLANG_TIDY": "OFF",
        "ENABLE_CLANG_FORMAT_CHECK": "OFF"
      }
    }
  ]
}
