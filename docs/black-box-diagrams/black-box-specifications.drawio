        <mxCell id="hq6BwTkVj39_qWa5lprl-7" value="Начало логирования данных в консоль" style="html=1;align=center;verticalAlign=top;rounded=1;absoluteArcSize=1;arcSize=10;dashed=0;whiteSpace=wrap;" parent="1" vertex="1">
