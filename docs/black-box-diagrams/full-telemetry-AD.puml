@startuml
title Activity — Legacy Telemetry Behavior (Black Box)

skinparam shadowing false
skinparam roundcorner 12

|Оператор|
start
:Запустить ПО;

|ПО|
:Инициализироваться;
:Загрузить адреса стенда/осей из конфига;
:Начать постоянный поток телеметрии;
:Начать вывод в консоль логов;

fork
  |ПО|
  while (ПО запущено?) is (да)

    :Писать данные/ошибки в консоль;

    if (Оси назначены на графики?) then (да)
      :Отрисовывать графики по текущим данным;
    else (нет)
      :Графики не отображаются\nили не связаны с осями;
    endif

    if (Есть связь со стендом по Wi-Fi?) then (да)
      |Стенд|
      :Передавать реальные данные;

      |ПО|
      :Использовать реальные данные стенда;
    else (нет)
      |ПО|
      :Использовать виртуальные/мусорные данные;
      :Выводить ошибки подключения в консоль;
    endif

  endwhile (нет)

fork again

  |Оператор|
  if (Назначить оси на графики?) then (да)
    |ПО|
    :Закрепить оси за графиками;
    :Начать отображать данные на графиках;
    note right
      Данные на графиках не обязаны быть валидными.
      Назначение оси только включает отображение
      текущего потока данных.
    end note
  endif

  |Оператор|
  if (Подключиться к стенду?) then (да)
    |ПО|
    :Попытаться достучаться до стенда по Wi-Fi;

    if (Стенд ответил?) then (да)
      :Подменить виртуальные данные реальными;
    else (нет)
      :Продолжить поток виртуальных/мусорных данных;
      :Выводить ошибки подключения;
    endif
  endif

  |Оператор|
  if (Удалить отображение графика?) then (да)
    |ПО|
    :Убрать график/привязку отображения;
    :Продолжить вывод данных в консоль;
  endif

fork again

  |Оператор|
  if (Запустить прогон?) then (да)
    |ПО|
    :Запустить прогон испытания;
    note right
      Прогон выполняется параллельно телеметрии.
      Он может быть запущен независимо
      от подключения к стенду.
    end note

    if (Остановить прогон?) then (да)
      :Остановить прогон испытания;
      :Телеметрия продолжает поступать;
    endif
  endif

end fork

|ПО|
:Завершить работу ПО;
stop

@enduml