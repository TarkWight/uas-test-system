@startuml
title Activity — Legacy Telemetry Lifecycle

skinparam shadowing false
skinparam roundcorner 12

|ПО|
start

:Запуск ПО;
:Инициализация ПО;
:Загрузка адресов из конфигурации;

:Запуск постоянного потока телеметрии;
:Запуск вывода сообщений в консоль;

while (ПО запущено?) is (да)

    :Получение данных телеметрии;

    if (Есть подключение к стенду?) then (да)

        |Стенд|
        :Передача реальных данных;

        |ПО|
        :Использование реальных данных;

    else (нет)

        |ПО|
        :Использование виртуальных/мусорных данных;
        :Вывод ошибок подключения;

    endif

    if (Оси назначены на графики?) then (да)
        :Отрисовка графиков;
    else (нет)
        :Продолжение работы без графиков;
    endif

    note right
      Поток телеметрии продолжает
      работать независимо:
      - от прогона испытаний
      - от наличия графиков
      - от подключения к стенду
    end note

endwhile (нет)

:Завершение работы ПО;
stop

@enduml
