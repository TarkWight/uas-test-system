@startuml
title Activity — Test Run Execution

|Оператор|
start
:Нажать кнопку "Start";

|UI|
:Отправить команду Start;

|Application|
:Запросить запуск TestRun;

|Infra|
:Подключиться к приводам;

if (Приводы доступны?) then (да)
    :Инициализировать управление осями;
else (нет)
    |UI|
    :Показать ошибку подключения;
    stop
endif

|Infra|
:Запустить поток телеметрии;

|Domain|
:Перевести TestRun в Running;

|Application|
:Начать цикл выполнения прогона;

while (TestRun активен?) is (да)

    fork
        |Infra|
        :Отправлять команды приводам;
    fork again
        |Infra|
        :Принимать телеметрию;
    fork again
        |UI|
        :Обновлять логи и графики;
    end fork

    |Оператор|
    if (Нажал Pause?) then (да)
        |UI|
        :Отправить команду Pause;
        |Domain|
        :Перевести TestRun в Paused;
        |Application|
        :Остановить отправку команд;
    endif

    |Оператор|
    if (Нажал Resume?) then (да)
        |UI|
        :Отправить команду Resume;
        |Domain|
        :Перевести TestRun в Running;
    endif

    |Application|
    if (Ошибка системы?) then (да)
        |Domain|
        :Перевести TestRun в Failed;
        stop
    endif

    |Оператор|
    if (Нажал Abort?) then (да)
        |UI|
        :Отправить команду Abort;
        |Domain|
        :Перевести TestRun в Aborted;
        stop
    endif

endwhile (нет)

|Application|
:Остановить телеметрию;
:Отключиться от приводов;

|Domain|
:Перевести TestRun в Completed;

|UI|
:Показать результат прогона;

stop
@enduml