@startuml
title Class Diagram — Test System (Clean Architecture + MVP)

skinparam shadowing false
skinparam roundcorner 12
skinparam classAttributeIconSize 0

' =====================
' DOMAIN LAYER
' =====================
package "Domain" {

  class TestRun {
    + start(): void
    + pause(): void
    + resume(): void
    + abort(): void
    + fail(): void
    + complete(): void
  }

  class TestProgram {
    + validate(): void
  }

  class WindProfile {
    + formula: Formula
    + beaufort: float
    + direction: float
    + angleOfAttack: float
    + validate(): void
  }

  class TestMetadata {
    + createdAt
    + operatorName
    + testPurpose
  }

  class TestConfiguration {
    + validate(): void
  }

  class Axis
  class TelemetryRecord {
    + timestamp
    + values
  }

  class TestReport {
    + generate(): void
  }

  enum TestRunState {
    Idle
    Running
    Paused
    Completed
    Aborted
    Failed
  }

  enum AxisState {
    Disconnected
    Connected
    Operating
    Stopped
    Error
  }

  enum TestProgramState {
    Draft
    Ready
  }

  class AxisId {
    + id: uint8
  }

  class RunId {
    + id: uint32
  }

  class ProgramId {
    + id: uint32
  }

  class ReportId {
    + id: uint64
  }

  TestRun --> TestProgram
  TestRun --> WindProfile
  TestRun --> TestConfiguration
  TestRun --> TestMetadata
  TestRun --> Axis
  TestRun --> TelemetryRecord
  TestRun --> TestReport

  TestProgram ..> TestProgramState
  TestRun ..> TestRunState
  Axis ..> AxisState

  TestRun ..> RunId
  Axis ..> AxisId
  TestProgram ..> ProgramId
  TestReport ..> ReportId
}

' =====================
' APPLICATION LAYER
' =====================
package "Application" {

  class StartTestRunUseCase {
    + execute(config: TestConfiguration): void
  }

  class PauseTestRunUseCase {
    + execute(runId: RunId): void
  }

  class ResumeTestRunUseCase {
    + execute(runId: RunId): void
  }

  class StopTestRunUseCase {
    + execute(runId: RunId): void
  }

  class LoadTestConfigurationUseCase {
    + execute(): TestConfiguration
  }

  StartTestRunUseCase --> TestRun
  PauseTestRunUseCase --> TestRun
  ResumeTestRunUseCase --> TestRun
  StopTestRunUseCase --> TestRun

  LoadTestConfigurationUseCase --> TestConfiguration
}

' =====================
' PORTS
' =====================
package "Ports" {

  interface AxisGateway {
    + connect(): void
    + sendCommand(): void
    + disconnect(): void
  }

  interface TelemetryGateway {
    + start(): void
    + stop(): void
  }

  interface ReportExporter {
    + export(report: TestReport): void
  }

  interface TestConfigurationRepository {
    + load(): TestConfiguration
  }
}

' =====================
' INFRASTRUCTURE
' =====================
package "Infrastructure" {

  class TcpAxisAdapter
  class VirtualAxisAdapter
  class TelemetryStreamAdapter
  class PdfReportExporter

  class TomlConfigRepository

  TcpAxisAdapter ..|> AxisGateway
  VirtualAxisAdapter ..|> AxisGateway
  TelemetryStreamAdapter ..|> TelemetryGateway
  PdfReportExporter ..|> ReportExporter

  TomlConfigRepository ..|> TestConfigurationRepository
}

' =====================
' PRESENTATION (MVP)
' =====================
package "Presentation" {

  interface MainView {
    + showStatus(): void
    + showError(): void
    + updateTelemetry(): void
  }

  class MainPresenter {
    + onStartPressed(): void
    + onPausePressed(): void
    + onResumePressed(): void
    + onStopPressed(): void
  }

  MainPresenter --> MainView
  MainPresenter --> StartTestRunUseCase
  MainPresenter --> PauseTestRunUseCase
  MainPresenter --> ResumeTestRunUseCase
  MainPresenter --> StopTestRunUseCase
  MainPresenter --> LoadTestConfigurationUseCase
}

@enduml