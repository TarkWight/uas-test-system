@startuml
left to right direction
skinparam shadowing false
skinparam roundcorner 12
hide methods
hide stereotypes

' =========================
' Enumerations
' =========================

enum AxisState {
  Disconnected
  Connected
  Operating
  Stopped
  Error
}

enum TestRunState {
  Idle
  Running
  Paused
  Completed
  Aborted
  Failed
}

enum TestProgramState {
  Draft
  Ready
}

' =========================
' AGGREGATE: TestProgram
' =========================

package "Aggregate: TestProgram" {

  entity "TestProgram\n<<Aggregate Root>>" as Program {
    programId
    name
  }

  note right of Program
  Агрегат-рутовая сущность программы испытаний.

  Инварианты:
  - Программа либо Draft, либо Ready
  - Ready => формула валидна
  - Ready => профиль нагрузки валиден
  - Пока Draft — старт запрещён
  end note

  entity "WindFormula\n(Формула ветра)" as Formula {
    expression
  }

  note right of Formula
  Отвечает за:
  - корректность выражения
  - доменную валидность формулы

  НЕ знает о TestRun
  end note

  entity "TimelinePoint\n(Точка профиля нагрузки)" as Point {
    timeSec
    value
  }

  note right of Point
  Элемент профиля нагрузки.
  Используется ТОЛЬКО
  в рамках программы испытаний.
  end note

  Program -- Formula
  Program -- Point

  Program ..> TestProgramState
}

' =========================
' AGGREGATE: TestRun
' =========================

package "Aggregate: TestRun" {

  entity "TestRun\n<<Aggregate Root>>" as Run {
    runId
    startedAt
    finishedAt
  }

  note right of Run
  Агрегат-рутовая сущность прогона.

  Инварианты:
  - Прогон создаётся ТОЛЬКО из Ready TestProgram
  - Во время Running конфигурация неизменяема
  - Telemetry добавляется только в Running/Paused
  - После Completed/Aborted/Failed прогон immutable
  end note

  entity "Axis\n(Ось привода)" as Axis {
    axisId
  }

  note right of Axis
  Runtime-сущность.
  Участвует в прогоне,
  не существует вне TestRun.
  end note

  entity "TelemetryRecord\n(Запись телеметрии)" as Telemetry {
    timestamp
    position
    torque
    voltage
    current
  }

  note right of Telemetry
  Фактические измерения.
  Принадлежат агрегату TestRun.
  end note

  entity "TestProtocol\n(Протокол испытаний)" as Protocol {
    protocolId
    conclusion
  }

  note right of Protocol
  Финальный результат прогона.
  Формируется ПОСЛЕ завершения.
  end note

  entity "TestMetadata\n(Реквизиты испытаний)" as Meta {
    organization
    operatorName
    testType
    date
  }

  note right of Meta
  Контекст испытаний.
  Используется при генерации отчёта.
  end note

  Run -- Axis
  Run -- Telemetry
  Run -- Protocol
  Protocol -- Meta

  Run ..> TestRunState
  Axis ..> AxisState
}

' =========================
' Cross-Aggregate Relationship
' =========================

Program ..> Run : starts

note on link
TestProgram порождает TestRun,
но НЕ владеет его жизненным циклом.
end note

@enduml